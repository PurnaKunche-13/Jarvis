# Copy to .env and `source .env` before starting the backend.
# Everything here is optional: Jarvis runs offline without it.

# JARVIS_API_KEY=sk-...
# JARVIS_API_BASE=https://api.openai.com/v1
# JARVIS_CHAT_MODEL=gpt-4o-mini
# JARVIS_STT_MODEL=whisper-1
# JARVIS_TTS_MODEL=gpt-4o-mini-tts
# JARVIS_TTS_VOICE=onyx
# JARVIS_SERVER_TTS=true
# JARVIS_WAKE_WORD=jarvis
# JARVIS_SEARCH_API_KEY=brave-...
# JARVIS_MAX_TOOL_ROUNDS=3
